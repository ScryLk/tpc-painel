// TPC Painel — Prisma schema
// Source of truth do dominio. Migrations geradas em prisma/migrations/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum MapState {
  STOCK
  STAGE1
  STAGE2
  STAGE3
}

enum Slot {
  MANHA
  TARDE
}

enum ServiceCategory {
  PERFORMANCE
  AESTHETIC
  CONFIG
}

enum SolicitacaoStatus {
  PENDENTE
  CONFIRMADA
  EM_EXEC
  CONCLUIDA
  CANCELADA
}

enum RemapOrderStatus {
  AWAITING_QUOTE
  QUOTE_SENT
  ANALYZING
  MAPPING
  AWAITING_REVIEW
  APPROVED
  NEEDS_REVISION
  CANCELLED
}

enum RemapFileKind {
  ORIGINAL
  MODIFIED
  ATTACHMENT
  REPORT
}

enum MessageSenderType {
  CUSTOMER
  TPC_STAFF
  SYSTEM
}

enum TransactionType {
  CREDIT
  DEBIT
  RESERVE
  UNRESERVE
}

enum PurchaseStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum MpPaymentMethod {
  PIX
  CREDIT_CARD
}

enum DataExportStatus {
  PROCESSING
  READY
  FAILED
  EXPIRED
}

// ============================================================================
// Core / Auth
// ============================================================================

model User {
  id              String    @id @default(uuid())
  clerkId         String    @unique
  email           String    @unique
  name            String
  phone           String?
  // CPF (11 dígitos) ou CNPJ (14). Único com sparse (NULL permitido múltiplo).
  cpfCnpj         String?   @unique
  // URL pública do avatar. Quando user sobe via Clerk SDK, copiamos imageUrl
  // do Clerk pra cá no próximo sync. Sempre absoluta.
  avatarUrl       String?
  role            Role      @default(CUSTOMER)
  pendingDeletion Boolean   @default(false)
  // Null = user nunca fechou o welcome modal do onboarding. Setado pelo
  // POST /me/onboarding/dismiss. "Completou" o onboarding é derivado de
  // cars.length, este campo só registra dismiss explícito.
  onboardingDismissedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  address         Address?

  cars            Car[]
  purchases       Purchase[]
  balance         PointsBalance?
  reservations    Reservation[]
  transactions    Transaction[]
  savedCards      SavedCard[]
  solicitacoes    Solicitacao[]
  remapOrders     RemapOrder[]
  messages        Message[]
  exportRequests  DataExportRequest[]
  deletionRequest AccountDeletion?
  consent         Consent?
  notifications   Notification[]
  leadReplies     Lead[]
  marketingCampaigns MarketingCampaign[]
  marketingDeliveries MarketingCampaignDelivery[]

  @@index([deletedAt])
}

model Car {
  id        String    @id @default(uuid())
  userId    String
  brand     String
  model     String
  year      Int
  motorType String
  plate     String
  color     String?
  isActive  Boolean   @default(true)
  mapState  MapState  @default(STOCK)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user         User          @relation(fields: [userId], references: [id])
  solicitacoes Solicitacao[]
  remapOrders  RemapOrder[]

  @@unique([userId, plate])
  @@index([userId, isActive])
}

// Catalogo presencial. 12 servicos no MVP.
model Service {
  id               String          @id @default(uuid())
  slug             String          @unique
  name             String
  description      String
  category         ServiceCategory
  pts              Int
  priceAvulsoCents Int             @default(0)
  motorTypes       String[]
  durationDays     Int             @default(1)
  popular          Boolean         @default(false)
  active           Boolean         @default(true)
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  solicitacoes Solicitacao[]

  @@index([active, sortOrder])
}

// Catalogo por arquivo. 9 servicos + 1 custom no MVP.
model RemapService {
  id               String   @id @default(uuid())
  slug             String   @unique
  name             String
  description      String
  category         String?  // 'Performance' | 'Aesthetic' | 'Config' | 'Custom'
  pts              Int
  priceAvulsoCents Int      @default(0)
  supports         String[]
  isCustom         Boolean  @default(false)
  active           Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  remapOrders RemapOrder[]

  @@index([active, sortOrder])
}

// Pacotes de pontos. 4 tiers fixos.
model Package {
  id          String   @id @default(uuid())
  tier        String   @unique
  name        String
  points      Int
  priceCents  Int
  bonusPoints Int      @default(0)
  bonusPct    Int      @default(0)
  popular     Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases Purchase[]

  @@index([active, sortOrder])
}

// ============================================================================
// Carteira / Transacoes
// ============================================================================

model Purchase {
  id              String          @id @default(uuid())
  userId          String
  packageId       String
  mpTransactionId String          @unique
  mpPaymentMethod MpPaymentMethod
  amountCents     Int
  installments    Int             @default(1)
  pointsCredited  Int
  status          PurchaseStatus  @default(PENDING)
  cpfCnpj         String?
  // Dados do checkout MP cacheados pra renderizar a tela sem nova chamada.
  qrCode          String?
  qrCodeBase64    String?
  checkoutUrl     String?
  mpExpiresAt     DateTime?
  // Snapshot do cartao quando o cliente pede "salvar pra proxima compra".
  // Webhook usa pra criar SavedCard depois de APPROVED. Sempre null em pix.
  saveCardSnapshot Json?
  paidAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  package      Package       @relation(fields: [packageId], references: [id])
  transactions Transaction[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}

// Saldo do usuario. available + reserved gerenciados em transacao SERIALIZABLE.
// CHECK constraints (available >= 0, reserved >= 0) aplicadas via migration SQL.
model PointsBalance {
  userId    String   @id
  available Int      @default(0)
  reserved  Int      @default(0)
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// Pontos reservados, aguardando confirmacao TPC (presencial) ou aprovacao cliente (remap).
// Expira em 24h se for solicitacao presencial sem confirmacao.
model Reservation {
  id            String       @id @default(uuid())
  userId        String
  amount        Int
  solicitacaoId String?
  remapOrderId  String?
  expiresAt     DateTime?
  releasedAt    DateTime?
  createdAt     DateTime     @default(now())

  user         User          @relation(fields: [userId], references: [id])
  solicitacao  Solicitacao?  @relation(fields: [solicitacaoId], references: [id])
  remapOrder   RemapOrder?   @relation(fields: [remapOrderId], references: [id])
  transactions Transaction[]

  @@index([userId, releasedAt])
  @@index([expiresAt])
}

// Append-only audit log. Nao update nem delete.
model Transaction {
  id            String          @id @default(uuid())
  userId        String
  type          TransactionType
  amount        Int
  balanceAfter  Int
  purchaseId    String?
  solicitacaoId String?
  remapOrderId  String?
  reservationId String?
  metadata      Json?
  createdAt     DateTime        @default(now())

  user        User         @relation(fields: [userId], references: [id])
  purchase    Purchase?    @relation(fields: [purchaseId], references: [id])
  solicitacao Solicitacao? @relation(fields: [solicitacaoId], references: [id])
  remapOrder  RemapOrder?  @relation(fields: [remapOrderId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([type])
}

// Cartoes tokenizados via Mercado Pago. NUNCA armazena PAN.
model SavedCard {
  id          String    @id @default(uuid())
  userId      String
  mpCardToken String
  brand       String
  lastFour    String
  holderName  String
  expMonth    Int
  expYear     Int
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, deletedAt])
}

// ============================================================================
// Pedidos presenciais
// ============================================================================

model Solicitacao {
  id             String            @id @default(uuid())
  protocol       String            @unique
  userId         String
  carId          String
  serviceId      String
  status         SolicitacaoStatus @default(PENDENTE)
  scheduledDate  DateTime
  endDate        DateTime?
  slot           Slot
  observations   String?
  pointsReserved Int               @default(0)
  pointsDebited  Int               @default(0)
  cancelReason   String?
  refundPct      Int?
  confirmedAt    DateTime?
  startedAt      DateTime?
  cancelledAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  car          Car           @relation(fields: [carId], references: [id])
  service      Service       @relation(fields: [serviceId], references: [id])
  reservations Reservation[]
  transactions Transaction[]

  @@index([userId, status])
  @@index([scheduledDate])
  @@index([status, scheduledDate])
}

// ============================================================================
// Pedidos por arquivo (file service)
// ============================================================================

model RemapOrder {
  id               String           @id @default(uuid())
  protocol         String           @unique
  userId           String
  carId            String?
  remapServiceId   String?
  status           RemapOrderStatus @default(AWAITING_QUOTE)
  isCustomQuote    Boolean          @default(false)
  ecuModel         String?
  hardwareUsed     String?
  readMode         String?
  vehicleVin       String?
  mileage          Int?
  description      String?
  quotePoints      Int?
  quoteAccepted    Boolean?
  quoteExpiresAt   DateTime?
  pointsReserved   Int              @default(0)
  pointsDebited    Int              @default(0)
  quotedAt         DateTime?
  mappingStartedAt DateTime?
  deliveredAt      DateTime?
  approvedAt       DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  car          Car?          @relation(fields: [carId], references: [id])
  remapService RemapService? @relation(fields: [remapServiceId], references: [id])
  files        RemapFile[]
  messages     Message[]
  reservations Reservation[]
  transactions Transaction[]

  @@index([userId, status])
  @@index([status])
}

model RemapFile {
  id           String        @id @default(uuid())
  remapOrderId String
  uploadedById String        // userId (cliente ou TPC staff)
  kind         RemapFileKind
  r2Key        String
  sha256       String
  fileName     String
  fileSize     Int
  mimeType     String
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?

  remapOrder RemapOrder @relation(fields: [remapOrderId], references: [id])
  messages   Message[]

  @@index([remapOrderId, kind])
  @@index([sha256])
}

model Message {
  id           String            @id @default(uuid())
  remapOrderId String
  senderUserId String?
  senderType   MessageSenderType
  body         String
  fileId       String?
  readAt       DateTime?
  createdAt    DateTime          @default(now())

  remapOrder RemapOrder @relation(fields: [remapOrderId], references: [id])
  sender     User?      @relation(fields: [senderUserId], references: [id])
  file       RemapFile? @relation(fields: [fileId], references: [id])

  @@index([remapOrderId, createdAt])
}

// ============================================================================
// LGPD
// ============================================================================

model DataExportRequest {
  id        String           @id @default(uuid())
  userId    String
  status    DataExportStatus @default(PROCESSING)
  r2Key     String?
  expiresAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
}

model AccountDeletion {
  id           String    @id @default(uuid())
  userId       String    @unique
  reason       String?
  scheduledFor DateTime
  executedAt   DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([scheduledFor, executedAt])
}

// Marketing default OFF, transacional default ON. NAO inverter (LGPD).
model Consent {
  userId                String   @id
  marketingEmail        Boolean  @default(false)
  marketingWhatsapp     Boolean  @default(false)
  transactionalPush     Boolean  @default(true)
  transactionalEmail    Boolean  @default(true)
  transactionalWhatsapp Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// Endereço opcional do cliente (1:1 com User). Usado pra emissão de NF e
// correspondência. CEP brasileiro (8 dígitos), UF em 2 letras.
model Address {
  userId       String   @id
  cep          String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String   // UF, 2 chars
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Notificações genéricas exibidas no sino do app. Cada user tem sua linha
// (broadcast = loop criando 1 por user) pra rastrear readAt individualmente.
// Eventos auto-criados pelo backend (pedido novo, TPC respondeu, status muda)
// + envios manuais do painel admin TPC (próximo PR).
model Notification {
  id        String           @id @default(uuid())
  userId    String
  kind      NotificationKind @default(INFO)
  title     String
  body      String?
  // Link relativo pra onde clique deve navegar (ex: /pedido/abc). Opcional.
  link      String?
  // Origem facilita debug + futura agregação ("3 novas msgs do pedido X").
  source    String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
}

enum NotificationKind {
  INFO       // neutro, ex: pedido criado
  SUCCESS    // verde, ex: arquivo entregue, pedido aprovado
  WARNING    // amarelo, ex: ação requerida
  EVENT      // azul/info pra updates de status
  ALERT      // vermelho, ex: pedido cancelado, problema
}

// ============================================================================
// Leads (form da landing externa tpcperformance.com.br)
// ============================================================================
// Landing POSTa em /leads (token-gated), painel armazena e admin responde.
// Cada lead permite 1 resposta no V1 (conversa continua no WhatsApp/email).

model Lead {
  id              String     @id @default(uuid())
  name            String
  email           String
  phone           String?
  vehicle         String?
  year            String?
  message         String
  // Origem do lead. Default 'landing' pra futuras integrações (Instagram form,
  // hot site de campanha, etc).
  source          String     @default("landing")
  status          LeadStatus @default(NEW)
  // Audit do request original.
  ipAddress       String?
  userAgent       String?
  // Preenchido quando admin responde. Status passa pra REPLIED na mesma tx.
  replyMessage    String?
  repliedAt       DateTime?
  repliedByUserId String?
  // Idempotência: landing pode passar Idempotency-Key pra evitar duplicar
  // lead em reenvios de form (network retry, double click).
  idempotencyKey  String?    @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  repliedBy User? @relation(fields: [repliedByUserId], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@index([email])
}

enum LeadStatus {
  NEW       // lead recebido, aguardando triagem
  REPLIED   // admin já respondeu por email
  ARCHIVED  // dispensado (spam, inválido), sem resposta
}

// ============================================================================
// Marketing campaigns
// ============================================================================
// Spec: specs/admin-marketing-campaigns.md. Fase 1: criar campanha (DRAFT),
// editar, disparar pra todos com Consent.marketingEmail=true. Snapshot do
// conteúdo na própria row — editar depois de SENT é bloqueado.

model MarketingCampaign {
  id             String         @id @default(uuid())
  subject        String         // assunto do email
  title          String         // título grande dentro do corpo
  body           String         // texto, parágrafos separados por \n\n
  ctaText        String?        // texto do botão (opcional)
  ctaUrl         String?        // link do botão (opcional)
  status         CampaignStatus @default(DRAFT)
  estimatedReach Int?           // count de destinatários elegíveis no envio
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  sentAt         DateTime?

  createdBy  User                        @relation(fields: [createdById], references: [id])
  deliveries MarketingCampaignDelivery[]

  @@index([status, createdAt(sort: Desc)])
}

enum CampaignStatus {
  DRAFT     // sendo composta, ainda não disparada
  SENDING   // fan-out em andamento (jobs na fila)
  SENT      // todos os jobs concluídos (sucesso ou falha individual)
  FAILED    // erro fatal antes do fan-out começar
}

model MarketingCampaignDelivery {
  id            String         @id @default(uuid())
  campaignId    String
  userId        String
  status        DeliveryStatus @default(QUEUED)
  queuedAt      DateTime       @default(now())
  sentAt        DateTime?
  openedAt      DateTime?      // populado por webhook Resend (Fase 2)
  clickedAt     DateTime?      // idem
  failureReason String?
  resendId      String?        // id do Resend pra cruzar com webhooks

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id])

  @@unique([campaignId, userId])
  @@index([userId])
  @@index([campaignId, status])
}

enum DeliveryStatus {
  QUEUED     // enfileirada, ainda não enviada
  SENT       // Resend aceitou (resposta 200 do POST /emails)
  DELIVERED  // webhook email.delivered (Fase 2)
  OPENED     // webhook email.opened (Fase 2)
  CLICKED    // webhook email.clicked (Fase 2)
  BOUNCED    // webhook email.bounced (Fase 2)
  FAILED     // erro no envio (rate-limit, validation, etc)
}
