# Copy to .env and fill in real values. NEVER commit .env.

# --- Runtime ---
NODE_ENV=development

# --- Database ---
DATABASE_URL=postgresql://tpc:tpc_dev@localhost:5432/tpc_painel?schema=public
DATABASE_URL_TEST=postgresql://tpc:tpc_test@localhost:5433/tpc_painel_test?schema=public

# --- Redis (jobs + cache) ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3001
API_HOST=0.0.0.0

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Auth (Clerk) ---
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me

# --- Mercado Pago ---
MP_ACCESS_TOKEN=TEST-replace-me
MP_PUBLIC_KEY=TEST-replace-me
MP_WEBHOOK_SECRET=replace_me

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tpc-files
R2_PUBLIC_BASE_URL=

# --- Email (Resend) ---
# Sem RESEND_API_KEY, o sistema entra em dry-run (loga em stdout, não envia).
RESEND_API_KEY=
# Domínio com SPF/DKIM configurado no Resend. Default usa onboarding@resend.dev
# (válido só pra dev/test). Em produção: noreply@tpcperformance.com.br ou similar.
EMAIL_FROM=TPC Performance <onboarding@resend.dev>
# Reply-to padrão de TODOS emails transacionais. Cliente responde direto na inbox.
EMAIL_REPLY_TO=atendimento@tpcperformance.com.br
# Email do admin TPC que recebe notificação de lead novo da landing.
ADMIN_EMAIL=delivered@resend.dev
# Token compartilhado entre landing externa e API. Landing manda no header
# X-Lead-Token quando POSTa em /leads. Sem token correto = 401. Gere com
# `openssl rand -hex 32` ou similar.
LEADS_INGEST_TOKEN=

# --- WhatsApp (provider TBD: Twilio / Z-API / Cloud API) ---
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=

# --- Observability (Sprint 5) ---
SENTRY_DSN=
