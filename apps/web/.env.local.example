# Copy to apps/web/.env.local. Next.js carrega automaticamente em dev.
# Vars sem NEXT_PUBLIC_ ficam server-side. NUNCA expor secrets com NEXT_PUBLIC_.

NEXT_PUBLIC_API_URL=http://localhost:3001

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# fallback = só usado quando não tem ?redirect_url na URL. Substitui as antigas
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL / _AFTER_SIGN_UP_URL, deprecadas no Clerk 5+.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
